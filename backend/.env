# SkillVerse AI Backend Environment Settings

APP_NAME="SkillVerse AI"
API_V1_STR="/api/v1"

# Database & Supabase Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
SUPABASE_URL="https://mock.supabase.co"
SUPABASE_JWT_SECRET="super-secret-jwt-token-key-placeholder"
SUPABASE_ANON_KEY="mock-anon-key-placeholder"
SUPABASE_SERVICE_ROLE_KEY="mock-service-role-key-placeholder"

# SMTP Email Verification Gateway Configurations
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@skillverse.ai"
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@skillverse.ai"
SMTP_FROM_NAME="SkillVerse AI Verification"
EMAIL_VERIFICATION_REQUIRED=true

# AI Engine API Key (Google Gemini AI)
GEMINI_API_KEY="your_gemini_api_key_here"

